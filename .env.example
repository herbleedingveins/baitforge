# BaitForge environment variables
# NEVER commit this file. Update .env.example instead.
# NEVER paste your token in chat or version control.

# Discord Bot Token
# MUST be reset after any exposure
# Get from: https://discord.com/developers/applications/1549619187398352997/bot
DISCORD_TOKEN=

# Discord Application ID
APPLICATION_ID=1549619187398352997

# Owner User ID (your Discord user ID)
# Only this user can add/remove/manage bait clips
OWNER_USER_ID=

# Allowed Channel ID
# All bot commands must be used in this channel
ALLOWED_CHANNEL_ID=1549621880846164069

# Database
# SQLite: sqlite:///./baitforge.db
# PostgreSQL: postgresql://user:password@localhost:5432/baitforge
DATABASE_URL=sqlite:///./baitforge.db

# File Storage
STORAGE_PATH=./storage

# Audio Processing
MAX_UPLOAD_SIZE_MB=25
DEFAULT_LOUDNESS_DB=0
MAX_LOUDNESS_DB=18
TEMP_DIR=./temp

# Logging
LOG_LEVEL=info

# Optional: Node environment
NODE_ENV=production
