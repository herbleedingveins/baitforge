{
  "name": "baitforge",
  "version": "1.0.0",
  "description": "Production-ready Discord audio bot with bait processing",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src",
    "db:migrate": "tsx src/storage/migrate.ts",
    "register-commands": "tsx src/commands/register.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "audio",
    "bait",
    "ffmpeg"
  ],
  "author": "slurz",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "fluent-ffmpeg": "^2.1.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/fluent-ffmpeg": "^2.1.4",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "vitest": "^1.1.0",
    "@vitest/ui": "^1.1.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
